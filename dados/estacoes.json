{
  "type": "FeatureCollection",
  "name": "estacoes",
  "metadados": {
    "descricao": "Estações do IPMA usadas na validação: comparação das normais da estação com a célula do Atlas. Não inclui valores observados do IPMA.",
    "fonte_estacoes": "IPMA, Normais Climatológicas 1991–2020 (fichas das estações)",
    "periodo": "1991–2020",
    "exportado_em": "2026-10-27",
    "estacoes": 51,
    "celula": "a mais próxima da estação dentro da máscara do Atlas (a que o mapa mostra); id_celula = id em celulas.geojson",
    "vies": "Atlas − IPMA, média anual dos 12 meses, sem correção de altitude (como os mapas)",
    "temperatura_media": "(TX + TN) / 2",
    "razao": "Atlas / IPMA; razao_p: precipitação anual; razao_p_verao: junho a agosto",
    "fonte_precipitacao": "CERRA-Land",
    "dia_da_precipitacao": "dia_do_fim",
    "ombrotipo": "ombrotipo_atlas: índice em metadados.json → classes.ombrotipo (o tipo do mapa; códigos do mais seco ao mais húmido); ombrotipo_dif: código do Atlas − código do ombrotipo calculado com a temperatura e a precipitação do IPMA — 0 igual, +1 o Atlas é uma classe mais húmido, −1 uma classe mais seco",
    "macrobioclima": "macrobioclima_atlas: índice em metadados.json → classes.macrobioclima (o do mapa); macrobioclima_igual: o mesmo que o calculado com a temperatura e a precipitação do IPMA (null se não houver)",
    "serie_curta": "nota da ficha do IPMA (série curta ou alterada); null nas outras",
    "series_hibridas": "todas as normais 1991–2020 do IPMA são séries híbridas (falhas preenchidas por modelo, nota das fichas)",
    "cabo": "Estação num cabo: a célula do modelo, de ~5,5 km, mistura terra e mar e não representa a exposição da ponta do cabo; as diferenças incluem esse efeito.",
    "alt_celula": "aqui é a altitude média do DEM na célula (a que a app mostra no clique); a coluna alt_celula de resultados/validacao/temperatura_por_estacao.csv (04) é outra coisa: a orografia da CERRA, que aqui se chama alt_modelo",
    "unidades": {
      "alt_estacao": "m",
      "alt_celula": "m (média do DEM na célula)",
      "alt_modelo": "m (relevo do modelo: a altitude a que a temperatura foi calculada)",
      "dist_km": "km",
      "vies_tx": "°C",
      "vies_tn": "°C",
      "vies_t": "°C",
      "razao_p": "adimensional",
      "razao_p_verao": "adimensional",
      "ombrotipo_dif": "n.º de classes (+ = Atlas mais húmido)"
    }
  },
